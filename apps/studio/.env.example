NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Supabase key; use a Secret key from Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server-only API origin; leave empty until the worker is configured.
STUDIO_WORKER_API_URL=
# Server-only: generate with `openssl rand -base64 32`; never use NEXT_PUBLIC_*.
STUDIO_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
